# Copy to .env and tweak. Every key is optional – see docs/CONVENTIONS.md.
# Precedence: -Dkey=value  >  environment variable  >  .env  >  default
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
TIMEOUT=15000
NAV_TIMEOUT=30000
BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://jsonplaceholder.typicode.com
DEMO_URL=https://playwright.dev
TRACE=retain-on-failure
VIDEO=off
SCREENSHOT=only-on-failure
# TAGS, PARALLEL and RETRIES are read by Maven, so set them as real environment
# variables (or pass -Dtags=..., -Dworkers=..., -Dretries=...).
