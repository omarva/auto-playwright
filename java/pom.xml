<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.autoplaywright</groupId>
  <artifactId>auto-playwright-java</artifactId>
  <version>1.0.0</version>
  <name>Auto Playwright - Java</name>
  <description>Playwright + Cucumber-JVM BDD test framework</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependency versions -->
    <playwright.version>1.65.0</playwright.version>
    <cucumber.version>8.0.4</cucumber.version>
    <junit.version>6.1.3</junit.version>
    <allure.version>3.1.1</allure.version>
    <allure.cli.version>2.46.2</allure.cli.version>
    <assertj.version>3.27.7</assertj.version>
    <jackson.version>2.23.0</jackson.version>
    <axe.version>4.14.0</axe.version>
    <dotenv.version>3.2.0</dotenv.version>
    <json-schema-validator.version>2.0.8</json-schema-validator.version>
    <slf4j.version>2.0.20</slf4j.version>

    <!-- Plugin versions -->
    <compiler.plugin.version>3.16.0</compiler.plugin.version>
    <surefire.version>3.6.1</surefire.version>
    <clean.plugin.version>3.5.0</clean.plugin.version>
    <exec.plugin.version>3.7.0</exec.plugin.version>
    <cucumber.reporting.version>5.11.0</cucumber.reporting.version>
    <allure.maven.version>3.1.0</allure.maven.version>
    <spotless.version>3.11.0</spotless.version>

    <!-- Runtime knobs: overridable with -D, or via the environment variables of the same
         (upper-case) name thanks to the env-* profiles below. -->
    <tags>not @wip</tags>
    <workers>2</workers>
    <retries>0</retries>
    <browser>chromium</browser>
    <reports.dir>${project.basedir}/reports</reports.dir>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-bom</artifactId>
        <version>${cucumber.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-bom</artifactId>
        <version>${allure.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.deque.html.axe-core</groupId>
      <artifactId>playwright</artifactId>
      <version>${axe.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-picocontainer</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-cucumber8-jvm</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Required by Cucumber's json formatter (Jackson 2 flavour). -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jdk8</artifactId>
      <version>${jackson.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>${json-schema-validator.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.cdimascio</groupId>
      <artifactId>dotenv-java</artifactId>
      <version>${dotenv.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <!-- Single source of truth: the repository-root features/ folder. -->
      <testResource>
        <directory>${project.basedir}/../features</directory>
        <targetPath>features</targetPath>
        <includes>
          <include>**/*.feature</include>
        </includes>
      </testResource>
      <!-- Shared JSON schemas for the API contract steps. -->
      <testResource>
        <directory>${project.basedir}/../features/schemas</directory>
        <targetPath>schemas</targetPath>
        <includes>
          <include>*.schema.json</include>
        </includes>
      </testResource>
    </testResources>

    <plugins>
      <!-- Wipe reports/ at the start of every run. -->
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <version>${clean.plugin.version}</version>
        <executions>
          <execution>
            <id>clean-reports</id>
            <phase>initialize</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <!-- Delete the CONTENTS only: reports/ may be a mounted Docker volume. -->
              <filesets>
                <fileset>
                  <directory>${reports.dir}</directory>
                  <includes>
                    <include>**/*</include>
                  </includes>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <filesets>
            <fileset>
              <directory>${reports.dir}</directory>
            </fileset>
          </filesets>
        </configuration>
      </plugin>

      <!-- This module only contains tests; don't produce an empty jar. -->
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>

      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${compiler.plugin.version}</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Unit-test phase is not used: scenarios run as integration tests so that the
           HTML report is generated (post-integration-test) before the build fails (verify). -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>

      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${surefire.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <includes>
            <include>**/RunCucumberIT.java</include>
          </includes>
          <reportsDirectory>${reports.dir}/junit</reportsDirectory>
          <rerunFailingTestsCount>${retries}</rerunFailingTestsCount>
          <trimStackTrace>false</trimStackTrace>
          <statelessTestsetReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5Xml30StatelessReporter">
            <usePhrasedFileName>false</usePhrasedFileName>
            <usePhrasedTestSuiteClassName>true</usePhrasedTestSuiteClassName>
            <usePhrasedTestCaseClassName>true</usePhrasedTestCaseClassName>
            <usePhrasedTestCaseMethodName>true</usePhrasedTestCaseMethodName>
          </statelessTestsetReporter>
          <systemPropertyVariables>
            <cucumber.filter.tags>${tags}</cucumber.filter.tags>
            <cucumber.execution.parallel.config.fixed.parallelism>${workers}</cucumber.execution.parallel.config.fixed.parallelism>
            <cucumber.execution.parallel.config.fixed.max-pool-size>${workers}</cucumber.execution.parallel.config.fixed.max-pool-size>
            <allure.results.directory>${reports.dir}/allure-results</allure.results.directory>
            <reports.dir>${reports.dir}</reports.dir>
            <BROWSER>${browser}</BROWSER>
            <playwright.version>${playwright.version}</playwright.version>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- Pretty HTML report (masterthought) – generated even when scenarios failed. -->
      <plugin>
        <groupId>net.masterthought</groupId>
        <artifactId>maven-cucumber-reporting</artifactId>
        <version>${cucumber.reporting.version}</version>
        <executions>
          <execution>
            <id>cucumber-html-report</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <projectName>Auto Playwright - Java (${browser})</projectName>
              <outputDirectory>${reports.dir}/html</outputDirectory>
              <inputDirectory>${reports.dir}/cucumber</inputDirectory>
              <jsonFiles>
                <param>**/*.json</param>
              </jsonFiles>
              <mergeFeaturesWithRetest>true</mergeFeaturesWithRetest>
              <skipEmptyJSONFiles>true</skipEmptyJSONFiles>
              <checkBuildResult>false</checkBuildResult>
              <classifications>
                <Language>Java ${maven.compiler.release}</Language>
                <Browser>${browser}</Browser>
                <Playwright>${playwright.version}</Playwright>
                <Cucumber>${cucumber.version}</Cucumber>
                <Tags>${tags}</Tags>
              </classifications>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- reports/html/index.html -> masterthought overview page -->
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.4.0</version>
        <executions>
          <execution>
            <id>html-report-index</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${reports.dir}/html</outputDirectory>
              <resources>
                <resource>
                  <directory>src/test/report-index</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ./mvnw exec:java@install-browsers  (installs ${browser} + OS deps) -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.plugin.version}</version>
        <executions>
          <execution>
            <id>install-browsers</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>com.microsoft.playwright.CLI</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>install</argument>
                <argument>--with-deps</argument>
                <argument>${browser}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ./mvnw allure:serve | allure:report -->
      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>${allure.maven.version}</version>
        <configuration>
          <reportVersion>${allure.cli.version}</reportVersion>
          <resultsDirectory>${reports.dir}/allure-results</resultsDirectory>
          <reportDirectory>${reports.dir}/allure-report</reportDirectory>
        </configuration>
      </plugin>

      <!-- ./mvnw spotless:check | spotless:apply -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <includes>
              <include>src/**/*.java</include>
            </includes>
            <googleJavaFormat/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Map the shared environment variables (docs/CONVENTIONS.md) onto Maven properties. -->
    <profile>
      <id>env-tags</id>
      <activation>
        <property>
          <name>env.TAGS</name>
        </property>
      </activation>
      <properties>
        <tags>${env.TAGS}</tags>
      </properties>
    </profile>
    <profile>
      <id>env-parallel</id>
      <activation>
        <property>
          <name>env.PARALLEL</name>
        </property>
      </activation>
      <properties>
        <workers>${env.PARALLEL}</workers>
      </properties>
    </profile>
    <profile>
      <id>env-retries</id>
      <activation>
        <property>
          <name>env.RETRIES</name>
        </property>
      </activation>
      <properties>
        <retries>${env.RETRIES}</retries>
      </properties>
    </profile>
    <profile>
      <id>env-browser</id>
      <activation>
        <property>
          <name>env.BROWSER</name>
        </property>
      </activation>
      <properties>
        <browser>${env.BROWSER}</browser>
      </properties>
    </profile>

    <!-- ./mvnw verify -Pdemo : watch the @demo tour in a real browser window. -->
    <profile>
      <id>demo</id>
      <properties>
        <tags>@demo</tags>
        <workers>1</workers>
      </properties>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <HEADLESS>false</HEADLESS>
                <SLOW_MO>500</SLOW_MO>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
